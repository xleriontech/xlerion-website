/**
 * Copia este archivo como config.local.php y rellena los valores.
 *
 * Lo ideal es guardarlo FUERA del webroot (un nivel arriba de public_html),
 * contact.php lo busca ahí automáticamente. Si lo dejas dentro de api/,
 * el api/.htaccess ya bloquea su acceso por HTTP.
 *
 * NUNCA subas config.local.php al repositorio.
 */

