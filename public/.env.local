# === CONFIGURACIÓN LOCAL DE DESARROLLO ===
# Este archivo contiene valores para desarrollo local
# NO debe ser committeado a Git (está en .gitignore)

# Servidor SMTP (para desarrollo local)
SMTP_HOST=mail.xlerion.com
SMTP_PORT=465
SMTP_USERNAME=support@xlerion.com

# Contraseña SMTP - REEMPLAZA CON TU CONTRASEÑA REAL
# Para desarrollo, puedes usar una contraseña temporal
SMTP_PASSWORD=YOUR_SMTP_PASSWORD_HERE

# Email Configuration
EMAIL_USER=contactus@xlerion.com
EMAIL_PASSWORD=YOUR_EMAIL_PASSWORD_HERE

# Entorno
ENVIRONMENT=development

# Database
DB_PATH=./data/admins.db

# CORS
ALLOWED_ORIGIN=http://localhost:5173
