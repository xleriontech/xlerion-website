# Xlerion Web - Environment Variables Example
# Copy this file to .env and set your own values

# ============================================
# GENERAL CONFIGURATION
# ============================================

# Technical Documentation Access
VITE_TECHNICAL_DOC_PASSWORD=REEMPLAZAR

# Application Settings
VITE_APP_NAME=Xlerion
VITE_APP_VERSION=1.0.0

# ============================================
# SMTP CONFIGURATION
# ============================================
# Used for: Total Darkness password recovery, Contact Form
# Server: mail.xlerion.com with SSL/TLS (Port 465)

# SMTP Server Host
SMTP_HOST=mail.example.com

# SMTP Port (465 for SSL/TLS, 587 for STARTTLS)
SMTP_PORT=465

# Email account for sending (created in cPanel)
SMTP_USERNAME=remite@example.com

# Password for the email account
SMTP_PASSWORD=REEMPLAZAR

# ============================================
# ANALYTICS DATABASE CONFIGURATION (MySQL)
# ============================================
# Remote MySQL server at xlerion.com hosting

# Database Host (IP or domain)
ANALYTICS_DB_HOST=127.0.0.1

# Database Port (default: 3306)
ANALYTICS_DB_PORT=3306

# Database Name
ANALYTICS_DB_NAME=analytics_db

# Database User
ANALYTICS_DB_USER=analytics_user

# Database Password
ANALYTICS_DB_PASS=REEMPLAZAR

# ============================================
# OPTIONAL: ANALYTICS CONFIGURATION
# ============================================

# Custom admin password hash for analytics panel
# Generate with: php -r "echo password_hash('your_password', PASSWORD_DEFAULT);"
# ANALYTICS_ADMIN_PASS_HASH=$2y$12$YOUR_HASH_HERE

